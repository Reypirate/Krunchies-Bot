BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
BOT_TIMEZONE=Asia/Singapore
DB_PATH=club.db

# Security: Comma-separated list of allowed Chat IDs (Groups or Users)
# You can find your group's ID by adding the bot to the group and using a command like /start
ALLOWED_CHAT_IDS=-100123456789,-100987654321

# Admin: Comma-separated list of Telegram User IDs for administrative access
ADMIN_IDS=123456789,987654321
